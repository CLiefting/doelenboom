# Productie-Dockerfile — los van het bestaande Dockerfile (dat blijft
# ongewijzigd voor lokale ontwikkeling: vite dev-server met hot reload). Alleen
# de productie-overlay (../docker-compose.prod.yml) gebruikt dit bestand.
#
# Stage 1: vite-build. VITE_API_URL leeg (default) = same-origin: de gebouwde
# app doet gewoon fetch('/api/...') en nginx (stage 2) stuurt dat intern door
# naar de api-container — zelfde aanpak als bij WWspeur, geen CORS nodig en
# geen domeinnaam hardcoded in de build.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Stage 2: statische bestanden serveren + /api/ doorsturen naar de api-container.
# DOEL-31: nginx-unprivileged draait als niet-root (uid 101) en luistert op
# 8080 (poorten < 1024 zijn dan niet toegestaan); Traefik verwijst daarom naar
# 8080 (docker-compose.prod.yml) en nginx.conf luistert daarop.
FROM nginxinc/nginx-unprivileged:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# DOEL-31d: --chmod=0644 zet die modus OOK op nieuw aangemaakte mappen (geen x-bit):
# /etc/nginx/snippets werd ontoegankelijk voor nginx (uid 101) en nginx startte niet.
# Symbolisch (X = x alleen bij mappen) geeft mappen 755 en bestanden 644, ongeacht
# de rechten in de werkmap.
COPY --chmod=u=rwX,go=rX nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=u=rwX,go=rX security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
