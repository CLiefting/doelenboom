POSTGRES_USER=doelenboom
POSTGRES_PASSWORD=doelenboom
POSTGRES_DB=doelenboom

# Verander dit voor elke omgeving buiten lokale ontwikkeling.
JWT_SECRET=dev-secret-verander-mij

# Alleen nodig als je de api buiten Docker Compose draait (compose zet dit al
# automatisch naar http://excel-service:8000).
EXCEL_SERVICE_URL=http://localhost:8000

# MFA-e-mail (tweestapsverificatie, zie doelenboom_mfa_ontwerp.md). SMTP_HOST
# leeg/ontbrekend (de standaard hier) = geen e-mail verstuurd, code komt
# alleen in de server-console te staan — veilige standaard voor lokale
# ontwikkeling. Voor Hostnet zelf (bevestigd): SMTP_HOST=smtp.hostnet.nl,
# SMTP_PORT=587, STARTTLS (secure:false in email.ts regelt dat automatisch
# bij poort 587) — zie set-smtp-env.sh om dit lokaal in te vullen zonder het
# wachtwoord in dit bestand te typen. Bewust smtp.hostnet.nl i.p.v. het door
# Hostnet voor webapplicaties gesuggereerde mailout.hostnet.nl: sommige VPN's/
# firewalls blokkeren die laatste specifiek (bekende bulkmail-relay), terwijl
# smtp.hostnet.nl (dezelfde mailbox, ander adres) gewoon doorkomt — functioneel
# gelijkwaardig voor dit lage volume (incidentele inlogcodes, geen bulkmail).
# SMTP_USER is de mailbox waarmee ingelogd wordt; SMTP_FROM is een alias
# daarvan en mag afwijken van SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply.doelenboom@code072.nl
