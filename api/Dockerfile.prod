# Productie-Dockerfile — los van het bestaande Dockerfile (dat blijft
# ongewijzigd voor lokale ontwikkeling: tsx watch met hot reload). Alleen de
# productie-overlay (../docker-compose.prod.yml) gebruikt dit bestand.
#
# Multi-stage: eerst compileren (incl. devDependencies/typescript nodig voor
# tsc), dan een schone runtime-laag met alleen de gecompileerde JS + productie-
# dependencies — geen typescript/tsx/@types/* in het uiteindelijke image.
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---------------------------------------------------------------------------
# SBOM-stage: genereert tijdens de image-build de Software Bill of Materials
# (CycloneDX) voor alle drie de Doelenboom-onderdelen en voegt ze samen tot de
# map die dependencyHealth.ts runtime inleest (SBOM_DIR=/app/sbom). Zo hoort de
# SBOM altijd bij precies de gebouwde/gedeployde versie, zonder handmatige stap
# (zie doelenboom_sbom_ontwerp.md in het project). Named build-contexts komen
# uit docker-compose.yml (additional_contexts):
#   sbom_tools — ./scripts   (sbom-postprocess.mjs)
#   web_src    — ./web       (package.json + package-lock.json van de web-app)
#   excel_sbom — de excel-service-image (bevat /sbom, gegenereerd uit de echt
#                geïnstalleerde Python-omgeving — transitieve pip-versies zijn
#                niet gepind, dus alleen die image weet wat er echt in zit)
# api en web: uit het package-lock.json (--package-lock-only), niet uit
# node_modules — geen installatie nodig en identiek aan wat `npm ci` installeert.
# ---------------------------------------------------------------------------
FROM node:24-alpine AS sbom
ARG BUILD_VERSION=dev
ARG GIT_REF=unknown
WORKDIR /in/api
COPY package.json package-lock.json ./
RUN npx --yes @cyclonedx/cyclonedx-npm@6.0.1 --package-lock-only \
      --output-format JSON --output-file /in/api/cdx.json
WORKDIR /in/web
COPY --from=web_src package.json package-lock.json ./
RUN npx --yes @cyclonedx/cyclonedx-npm@6.0.1 --package-lock-only \
      --output-format JSON --output-file /in/web/cdx.json
COPY --from=excel_sbom /sbom/excel-service.cdx.json /in/excel-service/cdx.json
COPY --from=excel_sbom /sbom/excel-service.runtime-names.json /in/excel-service/runtime-names.json
COPY --from=excel_sbom /sbom/requirements.txt /in/excel-service/requirements.txt
COPY --from=sbom_tools sbom-postprocess.mjs /tools/sbom-postprocess.mjs
RUN node /tools/sbom-postprocess.mjs --from /in --out /out \
      --build-version "$BUILD_VERSION" --git-commit "$GIT_REF"

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
# Build-versie (git-hash + datum) voor GET /api/version — zie ook het gewone
# Dockerfile en docker-compose.yml. Losse ARG/ENV hier omdat dit een eigen
# runtime-laag is (multi-stage build); zonder deze regels zou de productie-
# footer altijd "dev" tonen, ook als BUILD_VERSION wél is meegegeven.
ARG BUILD_VERSION=dev
ENV BUILD_VERSION=${BUILD_VERSION}
# DOEL-42: de app draait als USER node en mag niet afhangen van de rechten in de werkmap
# (bronbestanden op modus 600 zouden package.json onleesbaar maken). Symbolisch: mappen 755,
# bestanden 644 (zie DOEL-39/40/41).
COPY --chmod=u=rwX,go=rX package*.json ./
RUN npm ci --omit=dev
COPY --from=build --chmod=u=rwX,go=rX /app/dist ./dist
# SBOM van deze build (zie SBOM-stage hierboven) — als laatste laag, want de
# inhoud verandert bij elke build (tijdstip/serienummer/BUILD_VERSION).
# dependencyHealth.ts leest de SBOM uit SBOM_DIR; geen volume-mount meer.
ENV SBOM_DIR=/app/sbom
COPY --from=sbom /out/ /app/sbom/
# DOEL-31: niet als root draaien. De code, node_modules en /app/sbom blijven
# root-eigendom (alleen-lezen voor de app); schrijven gebeurt alleen naar
# /backups (bind mount, zie docker-compose.prod.yml — op de VPS moet de map
# ./backups schrijfbaar zijn voor uid 1000, zie deploy/README.md).
RUN mkdir -p /backups && chown node:node /backups
USER node
EXPOSE 4000
# Node heeft fetch ingebouwd; /api/health geeft 503 als de database niet bereikbaar is.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Direct node i.p.v. `npm start`: geen npm als PID 1 (dat geeft SIGTERM niet
# betrouwbaar door), zelfde commando als "start" in package.json.
CMD ["node", "dist/index.js"]
