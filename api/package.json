{
  "name": "doelenboom-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:db:reset": "tsx scripts/reset-test-db.ts",
    "pretest": "npm run test:db:reset",
    "test": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://doelenboom:doelenboom@localhost:5432/doelenboom_test}\" JWT_SECRET=\"${JWT_SECRET:-test-secret}\" EXCEL_SERVICE_URL=\"${EXCEL_SERVICE_URL:-http://localhost:8000}\" tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
